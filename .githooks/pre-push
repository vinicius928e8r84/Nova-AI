#!/bin/sh
remoto="$1"
raiz=$(git rev-parse --show-toplevel) || exit 0
regras=$(cd "$(dirname "$0")/.." && pwd)/scripts/regras/verificar.js
if ! command -v node >/dev/null 2>&1; then
  echo "aviso: node não encontrado; as regras de revisão foram puladas" >&2
  exit 0
fi
base=
for candidata in "${REGRAS_BASE:-}" "$remoto/main" origin/main; do
  if [ -n "$candidata" ] && git rev-parse --verify --quiet "$candidata^{commit}" >/dev/null; then
    base="$candidata"
    break
  fi
done
if [ -z "$base" ]; then
  echo "aviso: sem $remoto/main nem origin/main para comparar (git fetch origin main); as regras de revisão foram puladas" >&2
  exit 0
fi
zeros=0000000000000000000000000000000000000000
cabeca=$(git rev-parse HEAD 2>/dev/null)
barrado=0
while read -r ref_local sha_local ref_remota _; do
  [ "$sha_local" = "$zeros" ] && continue
  case "$ref_local" in refs/heads/*|HEAD) ;; *) continue ;; esac
  [ "$ref_remota" = refs/heads/main ] && continue
  if [ "$sha_local" != "$cabeca" ]; then
    echo "aviso: $ref_local não é o HEAD; as regras de revisão foram puladas" >&2
    continue
  fi
  echo "pre-push: $ref_local contra $base"
  node "$regras" --raiz "$raiz" --base "$base" || barrado=1
done
if [ "$barrado" -ne 0 ]; then
  echo "Push barrado: conserte o que está acima (o CI barraria igual) ou use git push --no-verify." >&2
  exit 1
fi
exit 0
