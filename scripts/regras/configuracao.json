  "consolePermitidoEm": [
    {"glob": "scripts/", "motivo": "ferramentas de linha de comando escrevem na saída"},
    {"glob": "test/", "motivo": "testes"},
    {"glob": "teste/", "motivo": "testes"},
    {"glob": "*.test.*", "motivo": "testes"},
    {"glob": "MAC/", "motivo": "ferramentas de integração e aplicação de patches"}
  ],
  "binarios": {
    "extensoesProibidas": ["dmg", "exe", "msi", "zip", "tgz", "gz", "bz2", "xz", "7z", "rar", "deb", "rpm", "pkg", "appimage", "apk", "ipa", "jar", "asar", "dll", "so", "dylib", "node", "pyc", "sqlite", "db"],
    "assinaturasProibidas": [
      {"nome": "executável Windows (MZ)", "hex": "4d5a"},
      {"nome": "executável Linux (ELF)", "hex": "7f454c46"},
      {"nome": "Mach-O 64 bits", "hex": "cffaedfe"},
      {"nome": "Mach-O 32 bits", "hex": "cefaedfe"},
      {"nome": "Mach-O universal", "hex": "cafebabe"},
      {"nome": "arquivo ZIP", "hex": "504b0304"},
      {"nome": "arquivo gzip", "hex": "1f8b"},
      {"nome": "pacote ar (.deb)", "hex": "213c617263683e"}
    ],
    "tamanhoMaximoMB": 8,
    "lixo": ["*.bak", "*.bak-*", "*.bak.*", "*.orig", "*.rej", "*.swp", "*~", "*.antes-*", ".DS_Store", "*.log"]
  },
  "arquivosProibidos": [
    "secret_key.json", "*_key.json", "remote_tokens.json", "id_iphone", "id_iphone.pub", "id_rsa", "id_ed25519", "id_ecdsa",
    ".env", ".env.*", "*.pem", "*.p12", "*.pfx", "*.keystore", "*.jks", "*.mobileprovision", ".npmrc", ".netrc",
    "credentials.json", "service-account*.json", "*.kdbx", ".wwebjs_auth/", ".wwebjs_cache/", "Partitions/", "browser-data*/", "teste-perfil-*/"
