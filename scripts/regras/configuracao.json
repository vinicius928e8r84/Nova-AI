  "extensoesDeComentario": ["js", "mjs", "cjs", "jsx", "ts", "tsx", "py", "html", "css", "sh", "bash", "command"],
  "ignorarCodigo": [
    {"glob": "dist/", "motivo": "saída de build e bundle da interface"},
    {"glob": "build/", "motivo": "saída de build"},
    {"glob": "release/", "motivo": "instaladores gerados"},
    {"glob": "browsers/", "motivo": "navegadores baixados"},
    {"glob": "node_modules/", "motivo": "dependências de terceiros"},
    {"glob": "vendor/", "motivo": "cópia de terceiros"},
    {"glob": "third_party/", "motivo": "cópia de terceiros"},
    {"glob": "coverage/", "motivo": "relatório de cobertura"},
    {"glob": "fixtures/", "motivo": "dados de teste"},
    {"glob": "reservas/", "motivo": "cópias do arquivo anterior guardadas antes de trocar o do app (AGENTS.md seção 5)"},
    {"glob": "backup*/", "motivo": "cópias de segurança de arquivos"},
    {"glob": "*.min.*", "motivo": "arquivo minificado"},
    {"glob": "*.map", "motivo": "source map"},
    {"glob": "*.lock", "motivo": "trava de pacotes"},
    {"glob": "package-lock.json", "motivo": "trava de pacotes"},
    {"glob": "npm-shrinkwrap.json", "motivo": "trava de pacotes"},
    {"glob": "yarn.lock", "motivo": "trava de pacotes"},
    {"glob": "pnpm-lock.yaml", "motivo": "trava de pacotes"}
