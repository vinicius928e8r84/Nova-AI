      "spawn",
      {
        "numero": 0,
        "programa": "ffmpeg",
        "argumentos": [
          "-y",
          "-v",
          "warning",
          "-listen",
          "1",
          "-i",
          "rtmp://127.0.0.1:19351/live/cam",
