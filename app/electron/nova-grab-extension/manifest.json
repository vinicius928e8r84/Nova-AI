{
  "manifest_version": 3,
  "name": "NOVA GRAB",
  "version": "1.0",
  "description": "IDM-style YouTube downloader for NOVA Browser",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*", "*://youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["*://*.youtube.com/*"]
}
