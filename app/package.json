{
  "name": "nova_dsktp",
  "version": "1.1.15",
  "description": "Nova AI - Your advanced desktop assistant.",
  "author": "The Carl Moon",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "browsers": "node scripts/baixar-navegador.js",
    "postinstall": "electron-builder install-app-deps && npm --prefix electron/services/iphone-setup install",
    "dist:mac": "electron-builder --mac dmg --arm64 --config.appId=local.nova.ai.mac \"--config.productName=Nova AI Mac\"",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@cliqz/adblocker-electron": "^1.34.0",
    "@cliqz/adblocker-playwright": "^1.34.0",
    "@google/genai": "^1.41.0",
    "@google/generative-ai": "^0.24.1",
    "@jitsi/robotjs": "^0.6.21",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@novnc/novnc": "^1.7.0",
    "@picovoice/porcupine-node": "^4.0.1",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "@supabase/supabase-js": "^2.106.2",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.9.0",
    "bplist-parser": "^0.3.2",
    "chrome-remote-interface": "^0.34.0",
    "cloudflared": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.1.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fix-webm-duration": "^1.0.6",
    "fluent-ffmpeg": "^2.1.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "mime-types": "^3.0.2",
    "node-media-server": "^4.2.8",
    "node-record-lpcm16": "^1.0.1",
    "nodemailer": "^8.0.9",
    "open": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.58.2",
    "plist": "^3.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.3",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.3",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.30.5",
    "tailwind-merge": "^3.4.0",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0",
    "whatsapp-web.js": "^1.34.6",
    "ws": "^8.20.1",
    "youtube-dl-exec": "^3.1.4",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "@electron/rebuild": "3.7.2",
    "bplist-creator": "^0.1.1",
    "electron": "34.5.8",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "@jitsi/robotjs": true,
    "better-sqlite3": true,
    "bufferutil": true,
    "cloudflared": true,
    "electron": true,
    "utf-8-validate": true,
    "youtube-dl-exec": true
  },
  "build": {
    "appId": "local.nova.ai",
    "productName": "Nova AI",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "electron/services/iphone-setup/node_modules/**/*",
      "!release/**",
      "!resources/**",
      "!browsers/**",
      "!**/*.bak*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "browsers",
        "to": "browsers"
      },
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "wake_word_bg.py",
        "to": "wake_word_bg.py"
      }
    ],
    "mac": {
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "artifactName": "Nova-AI-Mac-AppleSilicon-${version}.${ext}",
      "icon": "public/icon-512.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Nova usa a câmera nas funções de vídeo e assistente visual.",
        "NSMicrophoneUsageDescription": "Nova usa o microfone para comandos de voz.",
        "NSAppleEventsUsageDescription": "Nova controla os aplicativos escolhidos por você.",
        "NSSpeechRecognitionUsageDescription": "Nova reconhece comandos de voz.",
        "NSBluetoothAlwaysUsageDescription": "This app needs access to Bluetooth",
        "NSBluetoothPeripheralUsageDescription": "This app needs access to Bluetooth"
      }
    },
    "win": {
      "icon": "public/nova.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
