<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aquiles.novaproxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/novaproxy</string>
		<string>proxyd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/novaproxy.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/novaproxy.log</string>
</dict>
</plist>
