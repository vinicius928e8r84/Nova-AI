<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aquiles.novalocale</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/bin/bash</string>
		<string>/var/jb/usr/libexec/nova-locale.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/tmp/nova-locale.out</string>
	<key>StandardErrorPath</key>
	<string>/var/tmp/nova-locale.err</string>
</dict>
</plist>
